    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.4.0",
    "dompurify": "^3.4.12",
    "lit": "^3.3.3",
