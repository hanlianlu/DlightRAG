{
  "name": "dlightrag-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run check:icons && node --experimental-strip-types --test '!(*.browser).test.ts' '!(node_modules|.sourcemaps)/**/!(*.browser).test.ts'",
    "test:coverage": "npm run check:icons && node --experimental-strip-types --experimental-test-coverage --test '!(*.browser).test.ts' '!(node_modules|.sourcemaps)/**/!(*.browser).test.ts'",
    "test:browser": "web-test-runner --config web-test-runner.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "biome lint .",
    "lint:css": "stylelint 'styles/**/*.css' 'styles/**/*.module.css' 'design-system/**/*.css'",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "test:browser:cross-engine": "WTR_BROWSERS=chromium,firefox,webkit web-test-runner design-system/testing/design-system.browser.test.ts --config web-test-runner.config.mjs --group default"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.1.0",
    "@web/test-runner-playwright": "^1.0.2",
    "axe-core": "4.14.1",
    "lucide-static": "1.76.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@hyperdx/browser": "0.26.0",
    "@lit/localize": "^0.12.2",
    "dompurify": "^3.4.18",
    "lit": "^3.3.3",
    "mermaid": "^12.3.0",
    "valibot": "^1.5.0",
    "xstate": "^5.33.4"
  },
  "overrides": {
    "katex": "0.18.10",
    "lodash-es": "^4.18.1",
    "fflate": "0.8.3",
    "source-map-js": "^1.2.2"
  }
}
