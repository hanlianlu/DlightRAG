# Version control
.git
.github/
.gitignore

# Python
.venv
.venv-*/
venv/
ENV/
__pycache__
*.py[cod]
*$py.class
*.egg-info
*.egg
.eggs/
dist/
build/
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment
.env
.env.*
!.env.example
# The generated ClickStack secrets: `COPY packages/ packages/` would carry them into a layer.
**/stack/.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# OS
.DS_Store
Thumbs.db
# Docker
docker-compose.yml
Dockerfile
postgres/

# Dev/test files
tests/
docs/
# The Agent Browser pool images build from their own contexts.
agent-browser/
.test-results/
.import_linter_cache/
frontend/node_modules/
# Source maps for reported stacks stay on the host; the image's own build writes its own.
frontend/.sourcemaps/
# The image builds its own frontend; a host build must never travel in the context, or the image
# ends up carrying two bundles and index.html can point at the stale one.
src/dlightrag/adapters/http/browser/static/app/
scripts/
*.md
!README.md

# Worktrees
.worktrees/
# Storage
dlightrag_storage/
*.db
*.log

# Test coverage
.coverage
coverage.xml
