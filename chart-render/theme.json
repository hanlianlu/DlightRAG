{
  "color": "@categorical",
  "backgroundColor": "@background",
  "textStyle": {"fontFamily": "Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif", "color": "@textMuted"},
  "title": {"left": 24, "top": 20, "itemGap": 8,
            "textStyle": {"color": "@text", "fontSize": 20, "fontWeight": "bold"},
            "subtextStyle": {"color": "@textMuted", "fontSize": 14}},
  "legend": {"top": 80, "left": 24, "itemWidth": 14, "itemHeight": 12, "itemGap": 20,
             "inactiveColor": "@inactive", "textStyle": {"color": "@textMuted", "fontSize": 13}},
  "grid": {"top": 124, "left": 24, "right": 32, "bottom": 24, "outerBoundsMode": "same"},
  "categoryAxis": {"axisLine": {"show": true, "lineStyle": {"color": "@axisLine"}}, "axisTick": {"show": false},
                   "axisLabel": {"color": "@textMuted", "fontSize": 13, "margin": 12}, "splitLine": {"show": false},
                   "nameTextStyle": {"color": "@textMuted", "fontSize": 13}},
  "valueAxis": {"axisLine": {"show": false}, "axisTick": {"show": false},
                "axisLabel": {"color": "@textMuted", "fontSize": 13, "margin": 12},
                "splitLine": {"lineStyle": {"color": "@gridLine"}},
                "nameTextStyle": {"color": "@textMuted", "fontSize": 13}, "nameGap": 18},
  "timeAxis": {"axisLine": {"show": true, "lineStyle": {"color": "@axisLine"}}, "axisTick": {"show": false},
               "axisLabel": {"color": "@textMuted", "fontSize": 13, "margin": 12}, "splitLine": {"show": false}},
  "logAxis": {"axisLine": {"show": false}, "axisTick": {"show": false},
              "axisLabel": {"color": "@textMuted", "fontSize": 13}, "splitLine": {"lineStyle": {"color": "@gridLine"}}},
  "bar": {"barGap": "12%", "barCategoryGap": "28%",
          "itemStyle": {"borderRadius": [4, 4, 0, 0], "borderColor": "@gap", "borderWidth": 1}},
  "line": {"symbol": "circle", "symbolSize": 7, "showSymbol": false, "lineStyle": {"width": 2.5},
           "emphasis": {"focus": "series"}},
  "pie": {"radius": ["42%", "68%"], "center": ["50%", "58%"],
          "itemStyle": {"borderColor": "@gap", "borderWidth": 2},
          "label": {"color": "@textMuted", "fontSize": 13, "formatter": "{b}  {d}%"},
          "labelLine": {"lineStyle": {"color": "@axisLine"}}},
  "heatmap": {"itemStyle": {"borderColor": "@gap", "borderWidth": 2}},
  "tooltip": {"backgroundColor": "@tooltipBackground", "borderColor": "@tooltipBorder", "borderWidth": 1,
              "textStyle": {"color": "@tooltipText", "fontSize": 13}},
  "visualMap": {"inRange": {"color": "@sequential"}, "textStyle": {"color": "@textMuted"}},
  "palettes": {
    "highlight": {"color": "@highlight"},
    "sequential": {"color": "@sequential"},
    "diverging": {"color": "@divergingEnds", "visualMap": {"inRange": {"color": "@diverging"}}}
  }
}
