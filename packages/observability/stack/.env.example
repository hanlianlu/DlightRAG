# ClickStack stack for DlightRAG. Copy to `.env` — or let
# `dlightrag-observability bootstrap` do it, which fills the two secrets — and pass it to
# compose with `--env-file`.
#
# The ingestion key is seeded here rather than created through an API: HyperDX's OSS API has no
# endpoint for minting one, so an operator sets it once and every sender (the app, the probe)
# carries it in an `authorization` header.
HYPERDX_API_KEY=
# Signs the UI's sessions. The image's default is a well-known string; a deployment must not keep it.
EXPRESS_SESSION_SECRET=

# Where the stack listens. Everything but the UI and the OTLP endpoint is bound to loopback by
# compose; put a TLS reverse proxy in front of those two for anything but local development.
HYPERDX_APP_PORT=8300
HYPERDX_API_PORT=8000
HYPERDX_OTEL_HTTP_PORT=4318
HYPERDX_OTEL_GRPC_PORT=4317
HYPERDX_OTEL_HEALTH_PORT=13133
HYPERDX_OTEL_METRICS_PORT=8888
# Loopback-only, for `bootstrap`'s TTL statement and for an operator's own queries.
HYPERDX_CH_HTTP_PORT=8123
HYPERDX_OPAMP_PORT=4320

# One TTL for every otel_* table. There is no per-signal variable. This is the deployment's single
# statement of retention, and `bootstrap` applies it as stated — `36h` here is 36 hours of TTL
# there, not a rounded day count — to the tables the collector's variable cannot reach, one a
# signal creates with its first write, so the two never state different retentions.
# `bootstrap --days N` overrides it for one run with a whole-day count.
HYPERDX_OTEL_EXPORTER_TABLES_TTL=168h
# The shipped batch has no upper bound; a bounded one keeps a burst out of one giant insert.
HYPERDX_OTEL_BATCH_SEND_BATCH_MAX_SIZE=10000
HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE=default
HYPERDX_LOG_LEVEL=info
# The image reports usage to ClickHouse unless told not to.
USAGE_STATS_ENABLED=false

# Optional overrides. `alerts push` asks the stack's own API for its connection and for its trace
# and metric sources (the oldest of each, which is what the first seeding wrote), so nothing here
# needs setting. A value set here, or in the environment, is used as written and the API is not asked
# for it. The alert and dashboard files name them as ${VARIABLES} and carry no id of their own.
# HYPERDX_CONNECTION_ID=
# HYPERDX_SOURCE_TRACES=
# HYPERDX_SOURCE_METRICS=

# Alert delivery: `alerts push` reads these at push time and never commits them to an artifact.
# The chat id is the Telegram conversation the bot posts to; the URL carries the bot's token. The
# webhook itself is created by the push (and found again by its name), so it has no id to keep here.
DLIGHTRAG_TELEGRAM_CHAT_ID=
DLIGHTRAG_TELEGRAM_WEBHOOK_URL=
