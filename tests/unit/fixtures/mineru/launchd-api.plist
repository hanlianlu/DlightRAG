<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MINERU_ENV_FILE</key>
		<string>__LAUNCHD_HOME__/.env.mineru</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.hanlianlyu.dlightrag.mineru-api</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__LAUNCHD_HOME__/Library/Logs/dlightrag/mineru-api.err.log</string>
	<key>StandardOutPath</key>
	<string>__LAUNCHD_HOME__/Library/Logs/dlightrag/mineru-api.out.log</string>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
</dict>
</plist>
