# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Editor backups
*.bkp
.$*.drawio.bkp

# Virtual environments
.venv/
.venv-*/
venv/
ENV/

# Local planning artifacts
/docs/plans/
# Research notes are tracked (the write-ups); generated run artifacts under them are not:
# JSONL evaluation runs, logs and screenshots are outputs, not notes.
/docs/research/**
!/docs/research/**/
!/docs/research/**/*.md
# Memory-pass eval runs quote real conversations: private, never committed.
/docs/research/memory-pass-eval/runs/
docs/superpowers/
docs/upstream/
superpowers/
.superpowers/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
# OS
.DS_Store
Thumbs.db

# Environment
.env
!.env.example
.env.mineru

# Wizard backups (prerequisite_setup.py writes <file>.bak-<timestamp>)
*.bak-*

# Worktrees
.worktrees/

# Storage
dlightrag_storage/
output/
*.db

# Runtime logs (e.g. lightrag.log emitted at cwd by some upstream paths)
*.log

# Linting/typing caches
.ruff_cache/
.mypy_cache/
.import_linter_cache/

# Node.js
node_modules/
# No trailing slash: the pattern has to cover a symlinked install too, not only a
# directory. A committed `frontend/node_modules` symlink once slipped past it.
frontend/node_modules

# Vite output; built by `make frontend-build` and by the Dockerfile.
src/dlightrag/adapters/http/browser/static/app/

# Testing
.pytest_cache/
.test-results/
htmlcov/
.coverage
coverage.xml

# The chart renderer's resvg and font, installed by scripts/install-chart-tools.sh
.chart-tools/
# The skill demo writes its output beside whatever directory it is run from.
model-output.json

# Source maps for reported stacks: moved out of the served bundle by frontend/vite.config.ts.
frontend/.sourcemaps/

# Scratch work products of ad-hoc runs
/tmp/
