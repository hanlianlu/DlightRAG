#
# DlightRAG — secrets and deployment-only overrides
#
# Application behavior lives in config.yaml. Keep high-signal product and
# deployment choices there; keep rare tuning in docs/configuration.md. Use
# this file only for secrets or deployment-specific values that should not be
# committed.
#
# Priority: constructor args > environment variables > .env > config.yaml > defaults

# ─────────────────────────────────────────────────────────────────
# Required model credentials for the checked-in config.yaml
# ─────────────────────────────────────────────────────────────────

DLIGHTRAG_MODELS__CHAT__DEFAULT__API_KEY=
DLIGHTRAG_MODELS__EMBEDDING__API_KEY=
DLIGHTRAG_MODELS__CHAT__ROLES__EXTRACT__API_KEY=
DLIGHTRAG_MODELS__CHAT__ROLES__KEYWORD__API_KEY=
DLIGHTRAG_MODELS__CHAT__ROLES__QUERY__API_KEY=
DLIGHTRAG_MODELS__CHAT__ROLES__VLM__API_KEY=
DLIGHTRAG_MODELS__RERANK__API_KEY=

## Role credentials are needed only for role blocks you configure. The checked-in
## config.yaml configures all four roles and Voyage reranking. A role whose key is
## omitted or blank falls back to the complete default model configuration;
## `api_key: null` is reserved for a genuinely unauthenticated endpoint.

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Public Web Search + hosted extraction
# ─────────────────────────────────────────────────────────────────
## Configure either provider or both; ordered Search/Extract chains live in
## config.yaml. Anonymous direct URL reads remain available without either key.

DLIGHTRAG_ANSWER__WEB_SOURCES__EXA__API_KEY=
DLIGHTRAG_ANSWER__WEB_SOURCES__TAVILY__API_KEY=


# ─────────────────────────────────────────────────────────────────
# PostgreSQL credentials
# ─────────────────────────────────────────────────────────────────
## The bundled Compose stack needs only the password; Compose itself owns the
## `postgres` service hostname. For an external endpoint, prefer one stable
## non-secret owner in config.yaml. Uncomment the rest only as deployment or
## short-lived overrides, and do not duplicate those fields in YAML.

DLIGHTRAG_STORAGE__POSTGRES__PASSWORD=dlightrag
# DLIGHTRAG_STORAGE__POSTGRES__HOST=db.example.com
# DLIGHTRAG_STORAGE__POSTGRES__PORT=5432
# DLIGHTRAG_STORAGE__POSTGRES__USER=dlightrag
# DLIGHTRAG_STORAGE__POSTGRES__DATABASE=dlightrag
# DLIGHTRAG_STORAGE__POSTGRES__SSL_MODE=require

# OPTIONAL: Milvus/Zilliz vector leg. Select MilvusVectorDBStorage in
# config.yaml and install the dlightrag[milvus] extra. URI and database name
# may live in YAML; keep the compatible service token here.
# DLIGHTRAG_STORAGE__LIGHTRAG__MILVUS_TOKEN=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Only set if you configure official MINERU API access in config.yaml
# ─────────────────────────────────────────────────────────────────

# DLIGHTRAG_CORPUS__SIDECARS__MINERU__API_TOKEN=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Access (the checked-in default is auth_mode "none")
# ─────────────────────────────────────────────────────────────────

## config.yaml keeps the development default. A deployment sets its own access
## here, so its issuer, audience, and people stay out of the repository.
## See docs/security.md.

## One owner behind a token. Generate it with: openssl rand -base64 32
# DLIGHTRAG_ACCESS__AUTH_MODE=simple
# DLIGHTRAG_ACCESS__API_TOKEN=

## One owner per person, signed in by an identity provider (here Cloudflare
## Access). The issuer's discovery document names its keys, and each key names
## its algorithm.
# DLIGHTRAG_ACCESS__AUTH_MODE=jwt
# DLIGHTRAG_ACCESS__JWT_ISSUER=https://<team>.cloudflareaccess.com
# DLIGHTRAG_ACCESS__JWT_AUDIENCE=<application-aud-tag>
## The Web reads each person's token from the edge that signed them in.
# DLIGHTRAG_ACCESS__WEB_IDENTITY__EDGE=cloudflare
## Without rules every signed-in person holds everything. With rules, the rules
## decide, and each workspace's creator also holds it. This one: an admin, a
## default everyone reads, and workspaces of their own for everyone.
# DLIGHTRAG_ACCESS__CONTROL__RULES=[{"claim":"email","value":"admin@example.com","workspaces":["*"],"actions":["admin"]},{"claim":"iss","value":"https://<team>.cloudflareaccess.com","workspaces":["default"],"actions":["reader"]},{"claim":"iss","value":"https://<team>.cloudflareaccess.com","workspaces":["*"],"actions":["workspace.create"]}]

## A static key instead of published keys: an HS256 secret, or a public-key PEM
## with DLIGHTRAG_ACCESS__JWT_ALGORITHM naming its algorithm.
# DLIGHTRAG_ACCESS__JWT_VERIFICATION_KEY=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Docker Compose host binding
# ─────────────────────────────────────────────────────────────────
## Operator-provisioned global Agent Skills. The source must exist before
## `docker compose up`; the setup wizard creates the default directory. This
## Compose-only input intentionally does not use the application-reserved
## DLIGHTRAG_* namespace.

# COMPOSE_GLOBAL_SKILLS_DIR=/absolute/path/to/operator/skills

## PostgreSQL container tuning for the checked-in compose profile; defaults live
## in docker-compose.yml and docs/postgresql.md explains when to change them.

# COMPOSE_POSTGRES_SHARED_BUFFERS=8GB
# COMPOSE_POSTGRES_WORK_MEM=256MB
# COMPOSE_POSTGRES_MAINTENANCE_WORK_MEM=2GB
# COMPOSE_POSTGRES_EFFECTIVE_CACHE_SIZE=18GB
# COMPOSE_POSTGRES_MAX_CONNECTIONS=80
# COMPOSE_POSTGRES_SHM_SIZE=8gb

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Observability secrets - Configure non-secret Langfuse SDK behavior in config.yaml
# ─────────────────────────────────────────────────────────────────
## For local development, `make langfuse-up` runs a bundled Langfuse stack and
## fills these two keys for you (synced with the local stack). See docs/
## operations.md "Local Langfuse Observability". Set them by hand only for an
## external/cloud Langfuse. Both keys are required or tracing stays off. The
## non-secret endpoint (langfuse_host) lives in config.yaml, not here.

# DLIGHTRAG_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# DLIGHTRAG_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: RAGAS evaluation
# ─────────────────────────────────────────────────────────────────
## scripts/ragas_eval.py scores DlightRAG answers with RAGAS. Eval credentials
## auto-resolve when the query role uses an OpenAI-compatible provider.
## Native Anthropic/Gemini query roles require explicit EVAL_LLM_* values.
## Only uncomment below to override the auto-resolved values.
## Full guide: docs/evaluation.md

# EVAL_LLM_MODEL=
# EVAL_LLM_BINDING_API_KEY=
# EVAL_LLM_BINDING_HOST=
# EVAL_EMBEDDING_MODEL=
# EVAL_EMBEDDING_BINDING_API_KEY=
# EVAL_EMBEDDING_BINDING_HOST=
# EVAL_QUERY_TOP_K=10
# EVAL_MAX_CONCURRENT=2
# EVAL_LLM_MAX_RETRIES=5
# EVAL_LLM_TIMEOUT=180

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: External data-source secrets
# ─────────────────────────────────────────────────────────────────

# DLIGHTRAG_CORPUS__SOURCES__BLOB_CONNECTION_STRING=

## AWS credentials use the standard AWS_* environment variables.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=
# AWS_DEFAULT_REGION=

# Personal MCP bearer/OAuth envelope encryption. Secret source ONLY; never YAML.
# Generate each key using a trusted local CSPRNG: 32 random bytes, base64url encoded.
# Example shape only (placeholders are deliberately not usable keys):
# DLIGHTRAG_ANSWER__AGENT__CONNECTIONS__CREDENTIAL_SECRET_KEYRING='{"active":"<key-id>","keys":{"<key-id>":"<base64url-32-random-bytes>"}}'
# All workers need the same ring. Rotation: retain old IDs, add a fresh key and
# switch active. Re-encrypt live grants with secret-version CAS before removing
# old keys. Writer maintenance runs bounded re-encryption automatically; verify
# grant and short-lived inbox key counts first (docs/configuration.md).
# Keep backup/key retention aligned: deleting live ciphertext does not erase backups.
